# jstack config — copy to ~/.jstack/config.env (jstack-setup does this for you).
# Resolution order for every value: environment variable > ~/.jstack/config.env > built-in default.
# Lines are KEY=value. No quotes needed. Comments start with #.

# Persona used by jstack-msgdraft / jstack-voice when drafting in "your" voice.
JSTACK_PERSONA_NAME=the user

# Second-brain (llm-wiki) vault root. Required only for jstack-brainwork / jstack-savetobrain*.
# These skills also need the vault itself (a separate repo); see the README.
SECOND_BRAIN_PATH=~/second-brain

# Google Cloud / Vertex AI — required only for jstack-vision (the `gv` wrapper).
# Set this to YOUR GCP project. There is no default; vision fails fast without it.
GOOGLE_CLOUD_PROJECT=
# Optional: pin the billed project for `gv` independently of the ambient
# GOOGLE_CLOUD_PROJECT (use if your shell exports a different project elsewhere).
GEMINI_VISION_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# gv defaults to pro because gemini-cli 0.45 may remap flash to an unreachable
# gemini-3.x-flash (404). See vendor/gemini-vision/AGENTS.md.
GEMINI_VISION_MODEL=gemini-2.5-pro

# Where Claude Code stores per-project session JSONLs. Used by jstack-claude-find
# and jstack-savetobrain-from-claude.
CLAUDE_PROJECTS_DIR=~/.claude/projects

# Where /jstack-handoff writes handoff documents.
JSTACK_HANDOFF_DIR=~/.jstack/handoffs

# jstack-adscan wraps a separate adscan CLI repo (not bundled). Point this at it.
ADSCAN_DIR=~/builds/adscan
# Optional: default --out dir for adscan creatives. If set, /jstack-adscan writes
# there; otherwise it uses the current project's research/ads dir. For richer
# per-project mappings, use ~/.jstack/local.md.
ADSCAN_OUT=
