# jstack config — copy to ~/.jstack/config.env (jstack-setup does this for you).
# Resolution order for every value: environment variable > ~/.jstack/config.env > built-in default.
# Lines are KEY=value. No quotes needed. Comments start with #.

# Persona used by jstack-msgdraft / jstack-voice when drafting in "your" voice.
JSTACK_PERSONA_NAME=the user

# Second-brain (llm-wiki) vault root. Required only for jstack-brainwork / jstack-savetobrain*.
# These skills also need the vault itself (a separate repo); see the README.
SECOND_BRAIN_PATH=~/second-brain

# second-brain-sync requires the exact Git remotes. Empty values stop the sync.
SECOND_BRAIN_REMOTE=
JSTACK_PATH=~/jstack
JSTACK_REMOTE=

# Google Cloud / Vertex AI — required only for jstack-vision (the `gv` wrapper).
# Set this to YOUR GCP project. There is no default; vision fails fast without it.
GOOGLE_CLOUD_PROJECT=
# Optional: pin the billed project for `gv` independently of the ambient
# GOOGLE_CLOUD_PROJECT (use if your shell exports a different project elsewhere).
GEMINI_VISION_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# gv defaults to pro because gemini-cli 0.45 may remap flash to an unreachable
# gemini-3.x-flash (404). See vendor/gemini-vision/AGENTS.md.
GEMINI_VISION_MODEL=gemini-2.5-pro

# Where Claude Code stores per-project session JSONLs. Used by jstack-cc-find
# and jstack-savetobrain-from-cc.
CLAUDE_PROJECTS_DIR=~/.claude/projects

# jstack-schedule-cc: how long a headless run (`claude -p`) may wait for
# still-running background tasks (subagents, background bash) after its final
# turn ends before killing them, in milliseconds. The stock claude default is
# 600000 (10 min), which truncates long autonomous runs that delegate work to
# background subagents. 0 = wait indefinitely (risky: a leftover dev server
# keeps the run alive forever). Launcher default if unset: 7200000 (2 h).
JSTACK_SC_BG_WAIT_MS=7200000

# Where /jstack-handoff writes handoff documents.
JSTACK_HANDOFF_DIR=~/.jstack/handoffs

# jstack-adscan wraps a separate adscan CLI repo (not bundled). Point this at it.
ADSCAN_DIR=~/builds/adscan
# Optional: default --out dir for adscan creatives. If set, /jstack-adscan writes
# there; otherwise it uses the current project's research/ads dir. For richer
# per-project mappings, use ~/.jstack/local.md.
ADSCAN_OUT=

# Optional: pin playwright-core for jstack-linkedin-send/scripts/send_batch.js if
# require.resolve('playwright-core') and the npx-cache `find` fallback both miss
# (e.g. an unusual install layout). Usually not needed.
JSTACK_PLAYWRIGHT_CORE=

# jstack-savetobrain eval harness (references/eval/harness.py): path to the long
# (~200KB) real transcript clip used for the youtube-route efficiency probe.
# Only needed to run that eval locally; not required for normal skill use.
SAVETOBRAIN_EVAL_ANCHOR=

# tools/secrets-gate.sh: personal-identity regex patterns to scan for before
# push (names, handle, company, brands, codenames, GCP project id — anything
# grep -E can match). Multiple patterns joined by the `|||` delimiter, one -e
# per chunk, e.g.: MyName|||\bMyHandle\b|||my-gcp-project-id
# Leave empty/unset on a fresh clone: the gate still runs its generic checks
# (credential shapes, any /Users/<name> path) and prints a one-line notice.
SECRETS_GATE_PERSONAL_PATTERNS=
